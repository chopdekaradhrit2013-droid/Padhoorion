# Padhoorion Environment Configuration Example
# Copy this file to .env to customize settings

# Mode: true = Local Development Simulator (emails shown in console/logs)
#       false = Real SMTP delivery (requires SMTP credentials below)
SIMULATOR_MODE=true

# Security Settings
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
MAX_ATTEMPTS=3
RESEND_COOLDOWN_SECONDS=30

# Sender Details
SENDER_NAME=Padhoorion Security
SENDER_EMAIL=noreply@padhoorion.com

# Real SMTP Credentials (Used only if SIMULATOR_MODE=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Server Settings
API_HOST=127.0.0.1
API_PORT=8000
