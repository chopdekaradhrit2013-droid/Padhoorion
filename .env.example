# Database
DATABASE_URL="file:./dev.db"
# Set this to a long, random value in your deployment environment. Never commit the real secret.
JWT_SECRET="replace-with-a-random-secret"

# Email verification (choose one mail provider)
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords. Do not use your normal Gmail password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Alternatively, set SMTP_USER/SMTP_PASS and SMTP_HOST/SMTP_PORT.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Must be an address authorized by your email provider.
SMTP_FROM="PadhoOrion <your-email@gmail.com>"

# Optional Resend fallback
RESEND_API_KEY=""
